{
  "name": "perchance",
  "version": "1.0.0",
  "description": "TypeScript Perchance API — AI image & text generation with Turnstile bypass",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./camoufox": {
      "types": "./dist/src/camoufox.d.ts",
      "import": "./dist/src/camoufox.js"
    }
  },
  "bin": {
    "perchance": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/errors.test.js dist/tests/generator.test.js dist/tests/imageGenerator.test.js dist/tests/package.test.js dist/tests/textGenerator.test.js dist/tests/utils.test.js",
    "test:integration": "PERCHANCE_E2E=1 tsc && node --test dist/tests/integration.test.js"
  },
  "keywords": [
    "perchance",
    "ai",
    "image-generation",
    "text-generation",
    "turnstile-bypass"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "camoufox-js": "0.11.5",
    "commander": "^14.0.3",
    "playwright-core": "1.58.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "impit": false
  }
}
